FROM php:8.3-cli

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libmagickwand-dev \
    zip \
    unzip \
    git \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_pgsql \
        pgsql \
        gd \
        intl \
        zip \
        bcmath \
        opcache \
        mbstring \
        exif \
        pcntl

# imagick — required by bacon/qr-code to render ticket QR PNGs (email jobs).
RUN pecl install imagick && docker-php-ext-enable imagick

# Install Composer from official image
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Dev PHP tuning (OPcache + realpath cache) so `artisan serve` is fast.
COPY docker/php-dev.ini /usr/local/etc/php/conf.d/zz-dev.ini

WORKDIR /var/www/html

# Install PHP dependencies INTO THE IMAGE so vendor/ lives on the container's
# fast filesystem (served via a named volume), not the slow Windows bind mount.
# This is the single biggest dev-performance win on Docker Desktop / WSL2.
COPY composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --optimize-autoloader --prefer-dist

CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
