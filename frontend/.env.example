# Public URL — used by browser for media/audio URLs (must match APP_URL)
NEXT_PUBLIC_API_URL=https://your-domain.ge
NEXT_PUBLIC_APP_URL=https://your-domain.ge

# Server-side only (Docker internal) — Next.js rewrites /api → Laravel
# API_INTERNAL_URL=http://laravel:8000

# Google Analytics 4 measurement ID — leave unset in dev to avoid polluting real analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
