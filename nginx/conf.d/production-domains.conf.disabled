# Enabled by scripts/production-switchover.sh after certbot succeeds.

server {
    listen 443 ssl;
    http2 on;
    server_name tbilisistyle.com www.tbilisistyle.com;

    ssl_certificate /etc/letsencrypt/live/tbilisistyle.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tbilisistyle.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    include /etc/nginx/conf.d/security-headers.inc;

    # HSTS — HTTPS only. Start conservative; raise max-age once you are confident
    # HTTPS will stay up (1 year = 31536000). Consider hstspreload.org later.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/conf.d/app-locations.inc;
}
